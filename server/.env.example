# Server
PORT=3001

# ─── Auth ───────────────────────────────────────────────────────
# STRONGLY RECOMMENDED. If this is unset, env.js generates a random secret on
# first boot and persists it to db/.jwt_secret. It will NOT refuse to boot.
# Note the consequence: a free-tier deployment with an ephemeral filesystem
# regenerates that secret on every cold start, which silently invalidates every
# session. Set an explicit value in the deployment environment.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=generate_me

AUTH_USERNAME=admin
AUTH_PASSWORD=change_me
# Production: set a bcrypt hash instead of the plaintext password above.
# AUTH_PASSWORD_HASH=

# Token lifetime. Default 12h. Shortening this limits the damage a leaked token
# can do; lengthen it only if your operators restart the desktop app often.
# AUTH_TOKEN_TTL=12h

# Token generation counter. Bumping this value invalidates every outstanding
# token immediately, without rotating JWT_SECRET and logging everyone out on the
# next successful login. Use it as the emergency "log everyone out" lever.
# TOKEN_VERSION=1

# Daily assistant question budget, applied per authenticated user.
# The shared analysis budget is controlled separately by AI_DAILY_BUDGET.
# CHAT_DAILY_BUDGET=50

# Optional read-only desktop account. Set a username and either a password or
# bcrypt hash. Use placeholders here; set real values in the deployment env.
AUTH_ANALYST_USERNAME=your_analyst_username
AUTH_ANALYST_PASSWORD=your_analyst_password
# AUTH_ANALYST_PASSWORD_HASH=

# Optional second auth layer. When set, every request must also carry an
# X-API-Key header. Clients read this from the SENTINEL_API_KEY env var.
# API_SECRET_KEY=

# Never enable in production.
# ALLOW_PLAINTEXT_PASSWORD=false

# ─── Proxy trust ────────────────────────────────────────────────
# Number of trusted reverse proxies in front of this service. It decides both
# Express's `trust proxy` and the key used by every rate limiter.
#
#   1  -> deployed behind one TLS-terminating proxy (the Render setup). Correct.
#   0  -> the service is directly reachable. The TCP peer address is then
#         authoritative and X-Forwarded-For is ignored outright.
#
# Set this to 0 whenever you bind the service to a public interface. Leaving it
# at 1 while directly exposed lets a client forge X-Forwarded-For and mint a
# fresh rate-limit bucket per request, which defeats the login throttle.
# Invalid values are ignored and fall back to 0.
# TRUSTED_PROXY_HOPS=1

# ─── CORS ───────────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call the API. Leave empty to
# permit any origin (the desktop client sends no Origin header and is unaffected).
# Set this as soon as any browser-based client is used.
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# ─── API Keys ───────────────────────────────────────────────────
# Placeholder values are treated as unconfigured, so the boot banner is honest.
# https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# Powers AI chat, briefings, bias analysis, second-order effects and the
# prediction engine. https://console.groq.com
GROQ_API_KEY=

# Optional alternative provider.
OPENAI_API_KEY=

# ─── Optional feeds ─────────────────────────────────────────────
# Flight tracking OAuth client. Create one at opensky-network.org/my-opensky/account.
# Without these, aviation requests run anonymously and are more rate limited.
OPENSKY_CLIENT_ID=your_opensky_client_id
OPENSKY_CLIENT_SECRET=your_opensky_client_secret

# ─── Database ───────────────────────────────────────────────────
DB_PATH=./db/geoint.db

# Encrypted Vault (Aiven PostgreSQL). The server stores only client-encrypted
# metadata and chunks; it never receives the passphrase or plaintext.
# VAULT_DATABASE_URL=postgres://avnadmin:password@host:port/defaultdb
# VAULT_DB_SSL_CA=
# VAULT_DB_SSL_INSECURE=0
# VAULT_MAX_FILE_BYTES=104857600
# VAULT_QUOTA_BYTES=943718400
# Vault passkey: exactly 6 digits, stored only in the deployment environment.
# The desktop app authenticates against this value; the server never stores
# plaintext files. Example: VAULT_PASSKEY=123456
VAULT_PASSKEY=change_me

# ─── Render keep-alive (optional) ────────────────────────────────
# HEARTBEAT_URL=https://your-backend.onrender.com/api/health
